# Keep the build context small and the image clean.
# NOTE: src/assistant/gateway/static/app/ (the committed, pre-built SPA) is
# deliberately NOT ignored — the image serves it directly.

.git/
.github/
.venv/
web/node_modules/
web/dist/

# Python caches / build outputs
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.pytest_cache/

# Tests are not needed at runtime
tests/

# Local dev / secrets — never bake into the image
.env
.env*
*.env
LOCAL_PATHS.md
uv.lock

# Docs and scratch
docs/superpowers/
tmp/

# OS noise
.DS_Store
