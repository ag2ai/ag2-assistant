# AG2 Assistant — environment template. Copy to .env and fill in what you need:
#   cp .env.example .env
#
# Nothing here is required to boot: you can paste a provider key during the first-run
# onboarding in the web UI instead. Keys set here seed the assistant on startup; keys
# set via onboarding/Settings persist in the data volume.

# --- Model provider (pick one; Gemini is the default) ---------------------------
# Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- OpenAI via your ChatGPT/Codex subscription (instead of an API key) ----------
# Runs the assistant on your ChatGPT Plus/Pro subscription (OAuth, "Sign in with
# ChatGPT") rather than pay-per-token. UNOFFICIAL and likely against OpenAI's ToS —
# your account could be rate-limited. Sign in once: `ag2-assistant auth login`
# (or the button in Settings), then enable it:
# AG2ASSISTANT_LLM_PROVIDER=openai
# AG2ASSISTANT_OPENAI_AUTH_MODE=subscription
# AG2ASSISTANT_MODEL=gpt-5-codex        # a model your subscription grants
# Reverse-engineered endpoints/headers can drift; override without a code change:
# AG2ASSISTANT_CODEX_BASE_URL=https://chatgpt.com/backend-api/codex

# --- Messaging channels (only if you run `ag2-assistant run` with channels) -----
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=

# --- Optional overrides ----------------------------------------------------------
# In-container code execution is the default in Docker; set to "docker" only when the
# host Docker socket is mounted (see docker-compose.yml).
# AG2ASSISTANT_SANDBOX=local
# AG2ASSISTANT_LOCATION=City, Country
