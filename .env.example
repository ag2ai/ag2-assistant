# AG2 Assistant — environment template. Copy to `.env` and fill in what you need.
#   cp .env.example .env
#
# Everything here is OPTIONAL: you can also complete setup in the web onboarding
# at http://localhost:8800/ on first run. Values set here take precedence.

# --- Provider API key (default provider is Gemini) --------------------------
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Other providers (uncomment the one you use):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Messaging channels (optional) ------------------------------------------
# Set a token to enable that channel; leave blank to keep it off.
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=

# --- Assistant config overrides (optional, AG2ASSISTANT_* wins last) --------
# AG2ASSISTANT_LLM_PROVIDER=gemini
# AG2ASSISTANT_MODEL=
# Force the execution sandbox: 'local' or 'docker' (default: auto — 'docker'
# only when a Docker daemon is reachable, else 'local').
# AG2ASSISTANT_SANDBOX=
