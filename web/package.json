{
  "name": "ag2-assistant-web",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations --strategy globalVariable baseLocale",
    "check": "npm run i18n:compile && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "pretest": "sh ../scripts/gen_openapi.sh",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.24.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.20.1",
    "@types/three": "^0.185.3",
    "jsdom": "^29.1.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.7.4",
    "typescript": "^5.9.3",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "marked": "^15.0.6",
    "three": "^0.185.0",
    "zod": "^4.4.3"
  }
}
